# ATS Jugo — environment variables. Copy to ../.env and fill. NEVER commit real .env.

# ── App ──
APP_ENV=dev
LOG_LEVEL=INFO

# ── PostgreSQL ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jugo
POSTGRES_USER=jugo
POSTGRES_PASSWORD=changeme
# SQLAlchemy async DSN (asyncpg)
DATABASE_URL=postgresql+asyncpg://jugo:changeme@postgres:5432/jugo

# ── Redis (cache, queues, streams) ──
REDIS_URL=redis://redis:6379/0

# ── S3 (MinIO dev / cloud.ru S3 prod) ──
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=jugo-files
S3_REGION=ru-central1
S3_USE_SSL=false

# ── Auth / JWT ──
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=480

# ── PII encryption (AES-256-GCM) ──
PII_ENCRYPTION_KEY=base64-encoded-32-byte-key

# ── AI: LLM Gateway (prod: yandex, dev: openai) ──
AI_PROVIDER=openai
OPENAI_API_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/v1

# ── AI: embeddings (self-hosted TEI, BGE-M3 1024d) ──
TEI_URL=http://tei:80
EMBEDDING_DIM=1024
EMBEDDING_MODEL=BAAI/bge-m3

# ── Frontend ──
VITE_API_URL=http://localhost:8000

# ── Deploy (cloud.ru) ──
DEPLOY_HOST=176.108.250.112
DEPLOY_PORT=3025
DEPLOY_USER=user1
